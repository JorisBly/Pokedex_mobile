<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".PokemonDetailsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#6E3A15">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Skeledirge" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImage"
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="28dp"
                app:cardBackgroundColor="#25FFFFFF"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDetailName">

                <ImageView
                    android:id="@+id/ivDetailSprite"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:contentDescription="Pokemon Big Image"
                    tools:src="@tools:sample/avatars" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutHeaderRight"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="20dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                app:layout_constraintBottom_toBottomOf="@id/cardImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardImage"
                app:layout_constraintTop_toTopOf="@id/cardImage">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tvDetailType1"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:chipBackgroundColor="#B23C1B"
                        app:chipCornerRadius="100dp"
                        app:strokeWidth="0dp"
                        tools:text="Fire" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tvDetailType2"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:chipBackgroundColor="#4A3B80"
                        app:chipCornerRadius="100dp"
                        app:strokeWidth="0dp"
                        tools:text="Ghost" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/tvDetailCategory"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:gravity="center"
                    android:textAlignment="center"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipCornerRadius="12dp"
                    app:strokeWidth="0dp"
                    tools:text="Scarlet Description" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPhysical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="3"
                app:layout_constraintTop_toBottomOf="@id/cardImage">

                <com.google.android.material.chip.Chip
                    android:id="@+id/tvDetailWeight"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipCornerRadius="12dp"
                    app:strokeWidth="0dp"
                    tools:text="326.5 kg" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tvDetailHeight"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipCornerRadius="12dp"
                    app:strokeWidth="0dp"
                    tools:text="1.6 m" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tvDetailGeneration"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipCornerRadius="12dp"
                    app:strokeWidth="0dp"
                    tools:text="Gén. 9" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Statistiques de Base"
                android:textColor="#555555"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutPhysical" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvStatsTitle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="HP"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#555555"/>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbHp"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:max="255"
                        app:trackColor="#E0E0E0"
                        app:indicatorColor="#DCD014"
                        app:trackCornerRadius="4dp"
                        tools:progress="104" />

                        <TextView
                            android:id="@+id/tvValueHp"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textStyle="bold"
                            android:textColor="#212121" tools:text="104"/> </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="ATK"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#555555"/>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pbAtk"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            app:trackColor="#E0E0E0"
                            app:indicatorColor="#CDDC39"
                            app:trackCornerRadius="4dp"
                            tools:progress="75" />

                        <TextView
                            android:id="@+id/tvValueAtk"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textStyle="bold"
                            android:textColor="#212121" tools:text="75"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="DEF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#555555"/>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pbDef"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            app:trackColor="#E0E0E0"
                            app:indicatorColor="#CDDC39"
                            app:trackCornerRadius="4dp"
                            tools:progress="100" />

                        <TextView
                            android:id="@+id/tvValueDef"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textStyle="bold"
                            android:textColor="#212121" tools:text="100"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="S.ATK"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#555555"/>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pbSpeAtk"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="255"
                            app:trackColor="#E0E0E0"
                            app:indicatorColor="#CDDC39"
                            app:trackCornerRadius="4dp"
                            tools:progress="110" />

                        <TextView
                            android:id="@+id/tvValueSpeAtk"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textStyle="bold"
                            android:textColor="#212121" tools:text="110"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>